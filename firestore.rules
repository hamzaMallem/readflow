rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/documents/{documentId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.id == documentId
        && request.resource.data.updatedAt is number
        && (
          (request.resource.data.keys().hasOnly(['id', 'updatedAt', 'deleted'])
            && request.resource.data.deleted == true)
          || (request.resource.data.keys().hasAll(['title', 'content', 'paragraphs', 'tags', 'createdAt', 'lastReadAt', 'readingPosition'])
            && !request.resource.data.keys().hasAny(['deleted'])
            && request.resource.data.title is string
            && request.resource.data.content is string
            && request.resource.data.paragraphs is list
            && request.resource.data.tags is list)
        );
      // Keep deletion markers so an offline device cannot restore a deleted file.
      allow delete: if false;
    }
  }
}
